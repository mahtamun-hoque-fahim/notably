# ── Database (Neon) ──────────────────────────────────────────────
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct (unpooled) connection — used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── Better Auth ──────────────────────────────────────────────────
# Generate a strong secret, e.g.  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# ── App ──────────────────────────────────────────────────────────
# Canonical URL of the deployment (used by Better Auth base URL & Stripe redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (Pro tier — optional) ─────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
# Price ID of the recurring $5/mo Pro subscription.
STRIPE_PRICE_ID="price_..."
# Signing secret for the /api/webhooks/stripe endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── OpenAI (Whisper fallback + AI enrichment — optional) ─────────
# Enables cloud transcription (Firefox) and Pro note enrichment (title/summary/tags).
OPENAI_API_KEY="sk-..."
# Model used for note enrichment (optional; defaults to gpt-4o-mini).
OPENAI_ENRICH_MODEL="gpt-4o-mini"
