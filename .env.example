# ── Database (Neon) ──────────────────────────────────────────────
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct (unpooled) connection — used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── Better Auth ──────────────────────────────────────────────────
# Generate a strong secret, e.g.  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# ── App ──────────────────────────────────────────────────────────
# Canonical URL of the deployment (used by Better Auth base URL).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
